{
  "info": {
    "name": "EBS BioCrop Backend - Redesigned API Flow",
    "description": "Requests are numbered globally in execution order. Each request name states its action and access requirement. Categories are flat documents in one categories collection, linked by parentId with levels 0-2. Product payload examples use the current product and variant fields, including Display Rate, Printed MRP, cm dimensions, and product weight in g or kg. Replace example values with approved test data. The five database sample products are temporary TEST ONLY records and are not for sale. Seller onboarding, document storage, GST calculation, payment-provider confirmation, and seller order transitions remain deferred. Order creation supports customer advances of 10%, 20%, or 50%, plus an admin-assisted custom percentage. Admin and seller authentication now supports email OTP and email/password; customers remain phone OTP only. Phone OTP login is for customers and sellers; admins must use email OTP/password.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{customerAccessToken}}",
        "type": "string"
      }
    ]
  },
