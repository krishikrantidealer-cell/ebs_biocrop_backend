  "item": [
    {
      "name": "Public and customer APIs",
      "item": [
        {
          "name": "1. Health check - Public",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          }
        },
        {
          "name": "2. Send customer or seller phone OTP - Public",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/otp/send"
          }
        },
        {
          "name": "3. Verify customer or seller phone OTP - Public",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": "const response=pm.response.json(); const d=response.data || response; const role=(d.role || 'ROLE_CUSTOMER').toUpperCase(); const tokenVariable={ROLE_CUSTOMER:'customerAccessToken',ROLE_SELLER:'sellerAccessToken',ROLE_ADMIN:'adminAccessToken'}[role]; if(d.accessToken && tokenVariable) pm.collectionVariables.set(tokenVariable,d.accessToken); if(d.refreshToken) pm.collectionVariables.set('refreshToken',d.refreshToken); pm.test('OTP login returns a supported role',()=>pm.expect(tokenVariable,'role: '+role).to.be.ok);"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phoneNumber\": \"{{phoneNumber}}\",\n  \"otp\": \"{{otp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/otp/verify"
          }
        },
        {
          "name": "4. Refresh access token - Refresh token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/auth/token/refresh"
          }
        },
        {
          "name": "5. Get own profile - Authenticated user",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/user/profile"
          }
        },
        {
          "name": "6. Complete or update own profile - Authenticated user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"firstName\": \"Sample\",\r\n  \"lastName\": \"Customer\",\r\n  \"address\": {\r\n    \"villageArea\": \"Sample address\",\r\n    \"cityTehsil\": \"Indore\",\r\n    \"state\": \"Madhya Pradesh\",\r\n    \"pincode\": \"452001\",\r\n    \"address2\": \"Near Sample Landmark\"\r\n  }\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/v1/user/profile"
          }
        },
