    {
      "name": "Admin and seller authentication",
      "item": [
        {
          "name": "55. Send admin or seller email OTP - Admin/Seller account",
          "request": {
            "url": "{{baseUrl}}/api/v1/auth/email/otp/send",
            "method": "POST",
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "mode": "raw"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "56. Verify email OTP - Admin/Seller account",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": "const r=pm.response.json();const d=r.data||r;const role=(d.role||'').toUpperCase();const v={ROLE_SELLER:'sellerAccessToken',ROLE_ADMIN:'adminAccessToken'}[role];if(d.accessToken&&v)pm.collectionVariables.set(v,d.accessToken);if(d.refreshToken)pm.collectionVariables.set('refreshToken',d.refreshToken);pm.test('email OTP yields seller/admin role',()=>pm.expect(v,'role: '+role).to.be.ok);",
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "url": "{{baseUrl}}/api/v1/auth/email/otp/verify",
            "method": "POST",
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{emailOtp}}\"\n}",
              "mode": "raw"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "57. Login with email and password - Admin/Seller account",
          "request": {
            "url": "{{baseUrl}}/api/v1/auth/password/login",
            "method": "POST",
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{newPassword}}\"\n}",
              "mode": "raw"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "event": [
            {
              "script": {
                "type": "text",
                "exec": "const r=pm.response.json();const d=r.data||r;const role=(d.role||'').toUpperCase();const v={ROLE_SELLER:'sellerAccessToken',ROLE_ADMIN:'adminAccessToken'}[role];if(d.accessToken&&v)pm.collectionVariables.set(v,d.accessToken);if(d.refreshToken)pm.collectionVariables.set('refreshToken',d.refreshToken);pm.test('password login returns seller/admin role',()=>pm.expect(v,'role: '+role).to.be.ok);"
              },
              "listen": "test"
            }
          ]
        },
        {
          "name": "58. Set first password - Authenticated Admin/Seller",
          "request": {
            "url": "{{baseUrl}}/api/v1/auth/password/setup",
            "method": "POST",
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "mode": "raw"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "type": "string",
                "value": "{{sellerAccessToken}}",
                "key": "token"
              }
            ]
          }
        },
        {
          "name": "59. Request password reset email - Admin/Seller account",
          "request": {
            "url": "{{baseUrl}}/api/v1/auth/password/forgot",
            "method": "POST",
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"email\": \"{{email}}\"\n}",
              "mode": "raw"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "60. Reset password with email link - Admin/Seller account",
          "request": {
            "url": "{{baseUrl}}/api/v1/auth/password/reset",
            "method": "POST",
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"token\": \"{{passwordResetToken}}\",\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "mode": "raw"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          }
        },
        {
          "name": "61. Set first password - Authenticated Admin",
          "request": {
            "url": "{{baseUrl}}/api/v1/auth/password/setup",
            "method": "POST",
            "body": {
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "raw": "{\n  \"newPassword\": \"{{newPassword}}\"\n}",
              "mode": "raw"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ]
          },
          "auth": {
            "type": "bearer",
            "bearer": [
              {
                "type": "string",
                "value": "{{adminAccessToken}}",
                "key": "token"
              }
            ]
          }
        }
      ],
      "description": "Admin accounts must be provisioned with ROLE_ADMIN and email by the platform. Seller accounts must be provisioned with ROLE_SELLER and email. Email OTP and password login are for seller/admin only; password setup requires a signed-in seller/admin. In dev, OTP and reset links are logged by the app when MAIL_CONSOLE_DELIVERY_ENABLED=true."
    },
    {
      "name": "Customer order APIs",
      "auth": {
        "type": "bearer",
        "bearer": [
          {
            "key": "token",
            "value": "{{customerAccessToken}}",
            "type": "string"
          }
        ]
      },
      "description": "Order creation reserves stock and clears the customer cart. Use a dedicated test cart. Payment is not confirmed by these requests.",
      "item": [
        {
          "name": "62. Create partial-payment order (customer 10%)",
          "description": "Try advancePercentage 20 or 50 for the other supported customer options. Expected before payment confirmation: paymentState AWAITING_PAYMENT, paymentStatus null, amountPaid 0, advanceAmountDue equal to the selected percent of totalAmount.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"paymentMethod\": \"PARTIAL\",\n  \"advancePercentage\": 10,\n  \"shippingAddress\": {\n    \"name\": \"Test Customer\",\n    \"phoneNumber\": \"{{phoneNumber}}\",\n    \"villageArea\": \"Test address\",\n    \"addressLine2\": \"Test landmark\",\n    \"cityTehsil\": \"Indore\",\n    \"state\": \"Madhya Pradesh\",\n    \"pincode\": \"452001\"\n  }\n}",
