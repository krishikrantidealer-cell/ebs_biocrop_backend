      "name": "21. Get selected category details",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/categories/{{categoryDocumentId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Category detail returns 200\",function(){pm.response.to.have.status(200);});",
              "if(pm.response.code===200)pm.test(\"Selected category id matches\",function(){pm.expect(pm.response.json().data.id).to.eql(pm.collectionVariables.get(\"categoryDocumentId\"));});"
            ]
          }
        }
      ]
    }
,
    {
      "name": "Wishlist. Get my wishlist",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/v1/wishlist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Wishlist read returns 200\",function(){pm.response.to.have.status(200);});",
              "if(pm.response.code===200)pm.test(\"Wishlist items are an array\",function(){pm.expect(pm.response.json().data.items).to.be.an(\"array\");});"
            ]
          }
        }
      ]
    },
    {
      "name": "Wishlist. Save selected variant",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/v1/wishlist/items/{{variantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Wishlist add returns 200\",function(){pm.response.to.have.status(200);});",
              "if(pm.response.code===200){const d=pm.response.json().data;const id=pm.collectionVariables.get(\"variantId\");pm.test(\"Saved variant is present exactly once\",function(){pm.expect(d.items.filter(i=>i.variantId===id)).to.have.lengthOf(1);});pm.test(\"Wishlist count matches item list\",function(){pm.expect(d.count).to.eql(d.items.length);});}"
            ]
          }
        }
      ]
    },
    {
      "name": "Wishlist. Get wishlist after save",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/v1/wishlist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Wishlist read after save returns 200\",function(){pm.response.to.have.status(200);});if(pm.response.code===200)pm.test(\"Saved variant persists after read\",function(){pm.expect(pm.response.json().data.items.some(i=>i.variantId===pm.collectionVariables.get(\"variantId\"))).to.eql(true);});"
            ]
          }
        }
      ]
    },
    {
      "name": "Wishlist. Remove selected variant",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/v1/wishlist/items/{{variantId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Wishlist remove returns 200\",function(){pm.response.to.have.status(200);});if(pm.response.code===200){const d=pm.response.json().data;pm.test(\"Removed variant is absent\",function(){pm.expect(d.items.some(i=>i.variantId===pm.collectionVariables.get(\"variantId\"))).to.eql(false);});pm.test(\"Wishlist count matches item list\",function(){pm.expect(d.count).to.eql(d.items.length);});}"
            ]
          }
        }
      ]
    },
    {
      "name": "Wishlist. Clear wishlist (optional; destructive)",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}", "type": "text" }
        ],
        "url": "{{baseUrl}}/api/v1/wishlist"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Wishlist clear returns 200\",function(){pm.response.to.have.status(200);});if(pm.response.code===200)pm.test(\"Cleared wishlist has no variants\",function(){pm.expect(pm.response.json().data.items).to.be.empty;pm.expect(pm.response.json().data.count).to.eql(0);});"
            ]
          }
        }
      ],
      "disabled": true
    }
  ],
